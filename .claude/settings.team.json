{
  "_comment": "Scale層。チーム開発で settings.json にマージして有効化する。処理の実体は scripts/hooks.sh。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks.sh veto" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks.sh validate" }
        ]
      }
    ]
  }
}
